# Godot 4+ editor cache and mono/.NET build output
.godot/

# Editor / manual backups
*.bak
*.old
*.old.tscn

# Generated PDU channel translation tables (regenerated on build)
*.translation

# Import metadata for non-asset strays (real asset *.import files stay tracked)
/avatar-drone.csv.import
/icon.svg.import

# Case-variant duplicate strays of the tracked Ev3Pdu*.json (Ev3 vs EV3)
/ros_types/json/ev3_msgs/EV3PduActuator.json
/ros_types/json/ev3_msgs/EV3PduSensor.json

# hakodrone (offline mode) fetched by tools/fetch_native.ps1 from native.lock.json
/Plugins/Windows/x86_64/hakodrone.dll
/Plugins/Windows/x86_64/mujoco.dll
/Plugins/Windows/x86_64/hakodrone.h
/Plugins/Windows/x86_64/manifest.json
/Plugins/Windows/x86_64/LICENSE.md
/Plugins/Windows/x86_64/LICENSE-*.txt
/Plugins/Windows/x86_64/THIRD_PARTY_NOTICES-*.txt
/Plugins/Windows/x86_64/.native.lock.*.json
# Linux: the same set fetched by tools/fetch_native.sh ("os": "linux" in native.lock.json).
# ★ libshakoc.so is tracked (the bundled Hakoniwa core, same version as the local SDK)
/Plugins/Linux/x86_64/libhakodrone.so
/Plugins/Linux/x86_64/libmujoco.so*
/Plugins/Linux/x86_64/hakodrone.h
/Plugins/Linux/x86_64/manifest.json
/Plugins/Linux/x86_64/LICENSE.md
/Plugins/Linux/x86_64/LICENSE-*.txt
/Plugins/Linux/x86_64/THIRD_PARTY_NOTICES-*.txt
/Plugins/Linux/x86_64/.native.lock.*.json
/SimModels/courses_drone/
