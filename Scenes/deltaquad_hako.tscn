[gd_scene load_steps=8 format=3]

; ★★★★ DeltaQuad（リフト＆クルーズ・V8）を **箱庭 PDU で駆動する**可視化シーン。
;
;   プラント : hakoniwa-mujoco-drone の `swarm_app`（--hakoniwa で pos/motor を配信する）
;   このシーン: Drone_0/pos(ch1) と Drone_0/motor(ch0) を読んで機体を動かし、プロペラを回す
;
; ★★★★ **未解決（2026-09-09 ユーザ指摘）: マテリアルが当たっていない。**
;   GLB は image2sim の現物（`output/deltaquad/deltaquad.glb` をそのままコピー。
;   エレボン 0.700 x 0.095 m ／ スキッド有り ／ スパン 2.350 m ＝ **飛ばしている MJCF と同じ版**）だが、
;   Godot の描画は**明るい灰色＋白い箱**になる。GLB のマテリアルは
;   「機体ダークグレー(0.05)」「カーボンパイプ(0.02)」「プロペラ(0.03)」「LED シアン/レッド発光」で、
;   image2sim の正面図（`output/deltaquad/renders/front.png`）は**ほぼ黒**である。
;   → **形は合っているが色が当たっていない**ので「別の機体が飛んでいる」ように見える。
;   ★ 次にやること: import 設定は vtol_quadplane と同一なので、
;     ①`.scn` にマテリアルが入っているか ②`DroneAvatar` などが上書きしていないか を見る。
;
; ★ 機体は image2sim-framework の生成物（`config/deltaquad_model.yaml` → `.blend` → GLB／MJCF）。
;   **同じ .blend から、飛ばす MJCF と見せる GLB の両方が出ている。**
;   ★★★ 脚（スキッド）・大きくしたエレボン（主翼の 16.2%）まで入った版である（image2sim ab990e8）。
;
; ★ 起動順は決め打ち: プラント → このシーン → hako-cmd start。
;   箱庭は state==Stopped のときしかアセットを登録できない。
;   → `tools/deltaquad_godot.bash`（hakoniwa-mujoco-drone）が順番どおりに立ち上げる。
;
; ★ .tscn を手書きするときの落とし穴（[[godot-drone-linux-run]]）:
;   * Transform3D(...) の 12 数は **列ごと**（行で書くと転置した姿勢が入る）
;   * node_paths=PackedStringArray(...) に書けるのは **Node 型の export だけ**
;   * Camera3D.fov は既定で **垂直**画角
;   * ★ このリポジトリの機首は **-Z**（右 = -X / 上 = +Y）。glb もそう出ているので回さない。
;     （DeltaQuad は Blender で機首 +Y ＝ glTF の -Z。**宣言の front_axis は誤りだが幾何は正しい**）
;   * ★ SensorVizRig は置かない —— DroneAvatar が radar_points を無条件に read 宣言し、
;     この機体の PDU 定義に ch19 が無いと 4 GB のチャネルを作りに行って落ちる。
;   * ★ GLB は先に `--headless --import` しないと Godot が読めない（No loader found for resource）。

[ext_resource type="Script" path="res://Scripts/hakoniwa-sim/sim/HakoAsset.cs" id="1_hako"]
[ext_resource type="Script" path="res://Scripts/Hakoniwa/HakoSim/Drone/DroneAvatar.cs" id="2_avatar"]
[ext_resource type="Script" path="res://Scripts/Drone/DronePropeller.cs" id="3_prop"]
[ext_resource type="PackedScene" path="res://Models/deltaquad/deltaquad.glb" id="4_model"]
[ext_resource type="Script" path="res://Scripts/CameraGimbal.cs" id="5_gimbal"]

; ★★★ 地面は 20 km 四方 ＋ 10 m 方眼（drone3_hako と同じ）。
;   ★★★★ **方眼が無いと「速く飛んでいるのか止まっているのか」が絵で分からない**
;   —— 追従カメラで撮ると背景が一様な灰色になり、静止画にも動画にもならない（実際にそうなった）。
[sub_resource type="Shader" id="Shader_ground"]
code = "shader_type spatial;

uniform vec3 base_color : source_color = vec3(0.32, 0.34, 0.36);
uniform vec3 line_color : source_color = vec3(0.46, 0.49, 0.52);
uniform float grid_m = 10.0;
uniform float line_w = 0.02;

void fragment() {
	vec3 wp = (INV_VIEW_MATRIX * vec4(VERTEX, 1.0)).xyz;
	vec2 g = abs(fract(wp.xz / grid_m) - 0.5);
	float d = max(g.x, g.y);
	float w = line_w + fwidth(d) * 1.5;
	float line = smoothstep(0.5 - w, 0.5, d);
	ALBEDO = mix(base_color, line_color, line);
	ROUGHNESS = 0.9;
}
"

[sub_resource type="ShaderMaterial" id="Mat_ground"]
shader = SubResource("Shader_ground")

[sub_resource type="PlaneMesh" id="Mesh_ground"]
material = SubResource("Mat_ground")
size = Vector2(20000, 20000)

[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
tonemap_mode = 2
ambient_light_source = 3
ambient_light_energy = 0.55

[node name="DeltaquadHako" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.768221, -0.504536, 0.394055, 0, 0.615534, 0.78811, -0.640184, -0.605443, 0.472866, 0, 12, 0)
shadow_enabled = true
light_energy = 1.1

; ★★★ 地面は 20 km 四方。**巡航は 12 m/s × 8 分で 6 km 飛ぶ**ので、4 km 四方だと
;   途中で地面が尽きて「空中に浮いた板」になる（drone3_hako で踏んだ）。
[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh_ground")

; ★★★ **追従カメラ**。固定カメラでは巡航に入った瞬間に機体が豆粒になる（実際にそうなった）。
;   `CameraGimbal` は機体の位置に Offset を足した所に付き、機首方向を向く。
;   ★ このリポジトリの機首は **-Z** なので、**後ろ = +Z**。上から少し見下ろす。
; ★★★★ **近づけてある**（5 m 斜め後ろ）—— このシーンの見どころは
;   「**4 発が止まって、プッシャだけが回る**」ところなので、
;   12 m 引くと**ロータが何回転しているか分からない**（最初そうして撮り直した）。
[node name="Camera3D" type="Camera3D" parent="." node_paths=PackedStringArray("DroneNode")]
script = ExtResource("5_gimbal")
DroneNode = NodePath("../Deltaquad")
Offset = Vector3(0, 1.3, 5.5)
CameraRotate = 6.0
fov = 50.0

[node name="Hakoniwa" type="Node3D" parent="." node_paths=PackedStringArray("hakoObjects")]
script = ExtResource("1_hako")
customJsonFilePath = "./config/deltaquad_custom.json"
hakoObjects = [NodePath("../Deltaquad")]

; DroneAvatar は body(Node3D) と rd(RigidBody3D) が未設定だと EventInitialize で例外を投げる。
; 物理は MuJoCo 側が解くので、RigidBody3D は置くだけ（DroneAvatar が Freeze にする）。
[node name="Deltaquad" type="Node3D" parent="." node_paths=PackedStringArray("body", "rd")]
script = ExtResource("2_avatar")
robotName = "Drone_0"
body = NodePath("model")
rd = NodePath("RigidBody3D")
useTouchSensor = false

[node name="RigidBody3D" type="RigidBody3D" parent="Deltaquad"]

; y=0.169 … .blend 原点は接地面より 0.169 m 上（deltaquad_meta.json の spawn_z_m）。
; ★ この機体は**スキッド脚**が付いたので、原点は脚の接地面より上にある。
[node name="model" parent="Deltaquad" instance=ExtResource("4_model")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.169, 0)

; ch 番号と glb のノード名の対応は deltaquad_meta.json の rotors[].blend_name に合わせてある。
;   ch0 = F_L(ccw) / ch1 = F_R(cw) / ch2 = R_L(cw) / ch3 = R_R(ccw) / ch4 = PUSHER(ccw)
; ★★★★ **プッシャ（ch4）は回転軸が違う**（機体の前後軸まわり）。glb の中で既に倒してあるので
;   ここでは向きを触らない —— 揚力ロータ用の回転をそのまま使い回すと**プッシャだけ横に回る**。
; ★★★ リフト＆クルーズでは **ch0〜ch3 が 0 になり、ch4 だけ回る**。
;   ★ 見た目でそれが分かるのがこのシーンの主目的である。
[node name="Propellers" type="Node3D" parent="Deltaquad"]
script = ExtResource("3_prop")
propellerNodeNames = PackedStringArray("rotor_lift_fl_spin", "rotor_lift_fr_spin", "rotor_lift_rl_spin", "rotor_lift_rr_spin", "rotor_pusher_spin")
propellerSearchRoot = NodePath("../model")
spinDirections = PackedInt32Array(1, -1, -1, 1, 1)
enableAudio = false
maxRotationSpeed = 250.0

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Status" type="Label" parent="HUD"]
offset_left = 16.0
offset_top = 12.0
offset_right = 1200.0
offset_bottom = 40.0
text = "DeltaQuad lift+cruise (hakoniwa PDU) - 4 lift rotors stop in cruise, wing + pusher only"
