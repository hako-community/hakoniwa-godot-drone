[gd_scene load_steps=8 format=3]

; drone3（大型の 8 発機）を **箱庭 PDU で駆動する**可視化シーン（M2）。
;
;   プラント : MuJoCo 側の物理シミュレータ（箱庭アセットとして pos/motor を配信する）
;   このシーン: Drone/pos(ch1) と Drone/motor(ch0) を読んで機体を動かし、プロペラを回す
;
; drone3_viz.tscn との違いは駆動源だけ:
;   drone3_viz.tscn … DronePropellerDemoDriver（デモ用の内部ドライバ）
;   このシーン        … DroneAvatar（箱庭 PDU）
;
; ★ 起動順は決め打ち: プラント → このシーン → hako-cmd start。
;   箱庭は state==Stopped のときしか アセットを登録できないので、**start 後に起動すると必ず失敗する**。
;
; ★ .tscn を手書きするときの落とし穴（[[godot-drone-linux-run]]）:
;   * Transform3D(...) の 12 数は **列ごと**。行で書くと転置した姿勢が入る
;   * node_paths=PackedStringArray(...) に書けるのは **Node 型の export だけ**
;   * Camera3D.fov は既定で **垂直**画角

[ext_resource type="Script" path="res://Scripts/hakoniwa-sim/sim/HakoAsset.cs" id="1_hako"]
[ext_resource type="Script" path="res://Scripts/Hakoniwa/HakoSim/Drone/DroneAvatar.cs" id="2_avatar"]
[ext_resource type="Script" path="res://Scripts/Drone/DronePropeller.cs" id="3_prop"]
[ext_resource type="PackedScene" path="res://Models/drone3/drone3.glb" id="4_model"]
[ext_resource type="Script" path="res://Scripts/Hakoniwa/HakoSim/Drone/LiDAR3DController.cs" id="5_lidar"]
[ext_resource type="Script" path="res://Scripts/Components/Sensors/LiDAR/Default3DLiDARController.cs" id="6_lidar_dev"]

[sub_resource type="StandardMaterial3D" id="Mat_ground"]
albedo_color = Color(0.32, 0.34, 0.36, 1)

[sub_resource type="PlaneMesh" id="Mesh_ground"]
material = SubResource("Mat_ground")
size = Vector2(200, 200)

[sub_resource type="ProceduralSkyMaterial" id="Sky_mat"]

[sub_resource type="Sky" id="Sky"]
sky_material = SubResource("Sky_mat")

[sub_resource type="Environment" id="Env"]
background_mode = 2
sky = SubResource("Sky")
tonemap_mode = 2
ambient_light_source = 3
ambient_light_energy = 1.2

[node name="Drone3Hako" type="Node3D"]

[node name="WorldEnvironment" type="WorldEnvironment" parent="."]
environment = SubResource("Env")

[node name="DirectionalLight3D" type="DirectionalLight3D" parent="."]
transform = Transform3D(0.768221, -0.504536, 0.394055, 0, 0.615534, 0.78811, -0.640184, -0.605443, 0.472866, 0, 12, 0)
shadow_enabled = true
light_energy = 1.4

[node name="Ground" type="MeshInstance3D" parent="."]
mesh = SubResource("Mesh_ground")

; 機体を斜め後ろから見るカメラ（機首 = +Z）。
; ★ Transform3D の 12 数は **列ごと**: (x.x, y.x, z.x, x.y, y.y, z.y, x.z, y.z, z.z, ox, oy, oz)。
;   ここでは 位置 (6, 9.5, 7.5) から (0, 8.5, 0) を見る姿勢を手で組んである
;   （ホバリング高度 8 m + spawn 0.56 m あたりに機体が来る）。
[node name="Camera3D" type="Camera3D" parent="."]
transform = Transform3D(0.7809, -0.0647, 0.6213, 0, 0.9946, 0.1036, -0.6247, -0.0809, 0.7766, 6.0, 9.5, 7.5)
fov = 50.0

[node name="Hakoniwa" type="Node3D" parent="." node_paths=PackedStringArray("hakoObjects")]
script = ExtResource("1_hako")
customJsonFilePath = "./config/drone3_custom.json"
hakoObjects = [NodePath("../Drone3")]

; DroneAvatar は body(Node3D) と rd(RigidBody3D) が未設定だと EventInitialize で例外を投げる。
; ここでは物理は MuJoCo 側が解くので、RigidBody3D は Freeze/Kinematic で置くだけ
; （DroneAvatar が自分で Freeze に設定する）。
[node name="Drone3" type="Node3D" parent="." node_paths=PackedStringArray("body", "rd")]
script = ExtResource("2_avatar")
robotName = "Drone"
body = NodePath("model")
rd = NodePath("RigidBody3D")
useTouchSensor = false

[node name="RigidBody3D" type="RigidBody3D" parent="Drone3"]

; y=0.580595 … .blend 原点はスキッド接地面より 0.580595 m 上（drone3_meta.json の spawn_z_m）
; 180 度ヨー … glb の機首は -Z、このリポジトリの機体は機首 +Z なので合わせる
[node name="model" parent="Drone3" instance=ExtResource("4_model")]
transform = Transform3D(-1, 0, 0, 0, 1, 0, 0, 0, -1, 0, 0.580595, 0)

; ch 番号と glb のノード名の対応は drone3_meta.json の rotors[].blend_name に一致させてある。
; ★ .blend のロータ名は前後が反転しているので、ch0（機体前方内側左）は rotor_rear_inner_left。
; ★ spinDirections は省略すると +,-,+,- の交互になる。drone3 は交互ではないので明示する。
[node name="Propellers" type="Node3D" parent="Drone3"]
script = ExtResource("3_prop")
propellerNodeNames = PackedStringArray("rotor_rear_inner_left_spin", "rotor_rear_inner_right_spin", "rotor_rear_outer_left_spin", "rotor_rear_outer_right_spin", "rotor_front_outer_left_spin", "rotor_front_outer_right_spin", "rotor_front_inner_left_spin", "rotor_front_inner_right_spin")
propellerSearchRoot = NodePath("../model")
spinDirections = PackedInt32Array(1, -1, -1, 1, 1, -1, -1, 1)
enableAudio = false
maxRotationSpeed = 250.0

; ★ Pattern A（センシングは hakoniwa-mujoco-sensor 側）。
;   HAKO_EXTERNAL_SENSING=1 で起動すると DroneAvatar が lidar_points(ch16) を read 宣言し、
;   LiDARPointCloudVisualizer を自動で生やして PDU の点群を描く（自前ではレイを飛ばさない）。
;   位置は drone3 の MJCF の `lidar` サイト（FLU x=0.2966, z=0.0605）に合わせてある
;   （このリポジトリの規約 機首=+Z / 右=-X / 上=+Y に写すと Godot(0, 0.641, 0.2966)）。
[node name="LiDAR" type="Node3D" parent="Drone3"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.641095, 0.2966)
script = ExtResource("5_lidar")

[node name="sensor" type="Node3D" parent="Drone3/LiDAR"]
script = ExtResource("6_lidar_dev")

[node name="HUD" type="CanvasLayer" parent="."]

[node name="Status" type="Label" parent="HUD"]
offset_left = 16.0
offset_top = 12.0
offset_right = 900.0
offset_bottom = 40.0
text = "drone3 (hakoniwa PDU)"
