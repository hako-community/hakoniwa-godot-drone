<Project Sdk="Godot.NET.Sdk/4.7.1">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net9.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <DefineConstants>$(DefineConstants);NO_USE_UNITY</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <!-- Offline mode (no Hakoniwa plant): fetch the native set pinned in native.lock.json (hakodrone.dll, mujoco.dll,
       SimModels/courses_drone) before building. Skips quickly when already fetched. Set HAKO_SKIP_FETCH_NATIVE=1 to skip. -->
  <Target Name="FetchNative" BeforeTargets="BeforeBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\tools\fetch_native.ps1&quot;" />
  </Target>
</Project>